# ==============================================================================
# TenderHub MN - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for 1M+ context multimodal PDF OCR & structured extraction)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Database Credentials (PostgreSQL)
# Required for live production database upsert & vector search
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Vercel Cron Secret (Protects /api/cron/sync from unauthorized requests)
CRON_SECRET="your-secure-cron-secret-token"

# Optional: Cloudflare Stealth Scraping Proxy (ZenRows / ScrapingBee / ScraperAPI)
# ZENROWS_API_KEY="your-zenrows-key"
# SCRAPINGBEE_API_KEY="your-scrapingbee-key"
# SCRAPER_API_KEY="your-scraperapi-key"
